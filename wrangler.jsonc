// Rekonstruiert aus dem Live-Verhalten von https://mobi.bonni-jason.workers.dev (16.11.2026).
// Die Original-Konfiguration war per API nicht abrufbar (Worker liegt nicht im verbundenen Account).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mobi",
  // ANNAHME: echtes Datum unbekannt — vor dem ersten Deploy mit dem Dashboard abgleichen.
  "compatibility_date": "2026-11-01",
  // Reiner Static-Assets-Worker: kein "main", keine Bindings (App nutzt nur localStorage).
  "assets": {
    "directory": "./public",
    // Live: unbekannte Pfade (/foo, /api/x) liefern index.html mit 200.
    "not_found_handling": "single-page-application",
    // Live: /index.html -> 307 -> / (Default-Verhalten).
    "html_handling": "auto-trailing-slash"
  },
  // Live erreichbar unter *.workers.dev; eigene Routen/Domains nicht feststellbar.
  "workers_dev": true
}
